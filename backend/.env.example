# Copy to .env and fill in. Never commit .env.
PORT=3000

# MySQL (local on the game VPS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=codequest
DB_PASSWORD=changeme
DB_NAME=codequest

# RS256 public key used to verify JWTs minted by the main site's bridge.php.
# The matching PRIVATE key lives ONLY on the main site.
JWT_PUBLIC_KEY_PATH=/var/www/codequest/backend/keys/jwt_public.pem
JWT_ISSUER=joltcomputing.com
JWT_AUDIENCE=codequest

# Python ast validator microservice
VALIDATOR_URL=http://127.0.0.1:5001
